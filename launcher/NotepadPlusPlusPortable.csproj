<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>NotepadPlusPlusPortable</AssemblyName>
    <RootNamespace>NppPortableCommunity</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TargetFramework>net8.0</TargetFramework>
    <Version>1.0.0</Version>
    <Company>Unofficial Community Portable Builder</Company>
    <Product>Notepad++ Portable Community Launcher</Product>
  </PropertyGroup>
</Project>
